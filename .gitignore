# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Datasets crudos (pesados, regenerables)
data/raw/*
# pero conservamos el snapshot fechado del MapServer SEMARNAT
!data/raw/zofemat_bb_raw.geojson

# ZOFEMAT histórica combinada: 112 MB, excede el límite de 100 MB de GitHub.
# Regenerable con scripts/01c_download_zofemat_historico.py (cache en data/raw/).
# El artefacto que consume el sitio es web/public/tiles/zofemat_hist.pmtiles.
data/processed/zofemat_hist.geojson

# Imágenes raster pesadas
data/processed/*.tif
data/processed/*.tiff
data/processed/*.aux.xml
# pero conservamos los recortes a la bahía (cobertura del proyecto)
!data/processed/dem_bb.tif
!data/processed/sentinel_bb.tif

# Archivos comprimidos descargados
*.zip
*.tar
*.tar.gz

# Modelos de marea (FES2014 requiere registro AVISO+)
data/raw/tide_models/

# macOS
.DS_Store

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Variables de entorno (nunca commitear)
.env
.env*.local
.env.production
.env.test

# Logs
*.log
npm-debug.log*

# Editor / Claude Code
.vscode/
.idea/
*.swp
.claude/

# Cloudflare / Wrangler
.wrangler/
.dev.vars
